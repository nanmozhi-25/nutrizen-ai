# NutriZen AI Environment Variables Configuration (100% Free Tiers)

# 1. MongoDB Atlas Free M0 Cluster Connection URI
# Signup: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nutrizen?retryWrites=true&w=majority

# 2. JWT Secret Key (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=nutrizen_sec_9f8a3b127c4d5e6f8091a2b3c4d5e6f

# 3. Google Gemini API Key (Free Tier from Google AI Studio)
# Signup: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. USDA FoodData Central API Key (Free Key from USDA)
# Signup: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here

# 5. Web Push VAPID Keys (Generate via: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@nutrizen.ai

# 6. Secret key for securing background cron reminder checks (/api/cron/check-reminders)
# Trigger via cron-job.org every 10-15 mins with header 'x-cron-secret' or query '?secret='
CRON_SECRET=nutrizen_cron_secret_key_2026
