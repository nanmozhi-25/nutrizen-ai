# NutriZen AI Environment Variables Configuration

# 1. Google Gemini API Key (Free Tier from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. USDA FoodData Central API Key (Free Key from USDA: https://fdc.nal.usda.gov/api-key-signup.html)
# You can also test with DEMO_KEY if needed, but a free key gives 1,000 req/hr
USDA_API_KEY=your_usda_api_key_here

# 3. MongoDB Atlas Connection URI (Free M0 Cluster from https://www.mongodb.com/cloud/atlas/register)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nutrizen?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_uri_here

# 4. JWT Secret key for authentication
JWT_SECRET=nutrizen_jwt_secret_key_2026_super_secure

# 5. Web Push VAPID keys (Optional - Generated via npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nutrizen.ai
